root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.{bat,cmd}]
end_of_line = crlf

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false

[*.go]
indent_style = tab

[*.{dart,yml,yaml,json,proto,md}]
indent_style = space
indent_size = 2

# Flutter/Dart tool output (regenerated by flutter pub get / build).
.dart_tool/
.packages
.pub-cache/
.pub/
build/
coverage/
.flutter-plugins
.flutter-plugins-dependencies

# Platform runners' generated files (each runner folder also has its own .gitignore).
**/ephemeral/
**/Pods/
**/xcuserdata/

# Symbols and obfuscation maps from release builds.
app.*.symbols
app.*.map.json

# IDEs.
*.iml
*.ipr
*.iws
.idea/
# Widget Preview related
.widget_preview/
